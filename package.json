{
  "name": "cv",
  "description": "Curriculum Vitae",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node src/build.js",
    "watch": "chokidar 'src/**/*' -c 'npm run build'",
    "prestart": "npm run build",
    "start": "npm run watch & live-server dist",
    "lint": "eslint .",
    "format": "prettier --write 'src/**/*.{js,json,css}' 'scripts/**/*.js' '*.{js,json}'",
    "format:check": "prettier --check 'src/**/*.{js,json,css}' 'scripts/**/*.js' '*.{js,json}'",
    "check-links": "node scripts/check-links.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource/montserrat": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "bootstrap": "~5.2.3",
    "chokidar-cli": "^3.0.0",
    "dayjs": "^1.11.4",
    "eslint": "^9.39.5",
    "fs-extra": "^10.1.0",
    "gh-pages": "^6.0.0",
    "git-repo-name": "^1.0.1",
    "git-username": "^1.0.0",
    "globals": "^17.14.0",
    "handlebars": "^4.7.7",
    "live-server": "^1.2.2",
    "markdown": "^0.5.0",
    "prettier": "^3.10.1",
    "puppeteer": "^24.1.1",
    "speakingurl": "^14.0.1"
  }
}
